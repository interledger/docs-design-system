{
  "name": "@interledger/docs-design-system",
  "version": "0.14.2",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "description": "Shared styles and components used across all Interledger Starlight documentation sites",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "index.ts"
  ],
  "scripts": {
    "lint": "prettier --check '**/*.{js,mjs,ts,tsx,json,md,mdx,astro}' && eslint --max-warnings=0 .",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx,json,md,mdx,astro}' && eslint --max-warnings=0 --fix .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Interledger <tech@interledger.org>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interledger/docs-design-system.git"
  },
  "dependencies": {
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.73.0",
    "astro": "^7.4.12",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
